+        glBlitFramebuffer(0, 0, sc<int>(SCRATCH_SIZE.x), sc<int>(SCRATCH_SIZE.y), 0, 0, sc<int>(PMONITOR->m_pixelSize.x), sc<int>(PMONITOR->m_pixelSize.y), GL_COLOR_BUFFER_BIT,
+                           GL_LINEAR);
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        if (selfCapScaleLogNow)
+            Log::logger->log(Log::DEBUG, "[selfCapScale] blitted scratch {}x{} -> background {}x{}", SCRATCH_SIZE.x, SCRATCH_SIZE.y, PMONITOR->m_pixelSize.x, PMONITOR->m_pixelSize.y);
+    } else
+        Log::logger->log(Log::ERR, "[selfCapScale] BUG: scratch/background dynamic_cast to CGLFramebuffer failed, snapshot not updated this call");
+
+    m_bRenderingSnapshot = false;
+    return PFRAMEBUFFER;
+}
+
+// CLAUDE/local: no_self_capture perf, grouped rendering. Same structure as
+// makeSelfCaptureBackgroundFB above, but hides EVERY layer in pLayers
+// simultaneously and returns ONE framebuffer for the caller to assign to
+// all of them — only correct when none of them geometrically overlap each
+// other (enforced by the caller, see renderMonitor's own overlap check
+// before this is ever invoked). See makeSelfCaptureBackgroundFB's own
+// comment for the full "attempt 4" scratch-FB downscale reasoning — same
+// technique here, just against the group's shared framebuffer instead of
+// one layer's own.
+SP<IFramebuffer> IHyprRenderer::makeSharedSelfCaptureBackgroundFB(PHLMONITOR pMonitor, const std::vector<PHLLS>& pLayers, CRegion dirtyRegionMonitorSpace) {
+    if (!pMonitor || !pMonitor->m_output || pMonitor->m_pixelSize.x <= 0 || pMonitor->m_pixelSize.y <= 0)
+        return nullptr;
+
+    if (!pMonitor->m_activeWorkspace)
+        return nullptr;
+
+    if (pLayers.empty())
+        return nullptr;
+
+    // Consumer-facing — ALWAYS full monitor size, reused across the group
+    // exactly as before (every member ends up pointing at this SAME
+    // object once the caller assigns it, which is what makes this
+    // "shared" rather than "the first member's own").
+    SP<IFramebuffer> framebuffer = pLayers.front()->m_selfCaptureBackground;
+    if (!framebuffer)
+        framebuffer = createFB("shared self-capture background");
+    if (framebuffer->m_size != pMonitor->m_pixelSize)
+        framebuffer->alloc(pMonitor->m_pixelSize.x, pMonitor->m_pixelSize.y, DRM_FORMAT_ABGR8888);
+    framebuffer->setImageDescription(pMonitor->workBufferImageDescription());
+
+    // Scratch — shared across the group the same way, but this object
+    // isn't returned to (or known by) the caller at all, so it has to be
+    // explicitly propagated to every member itself, unlike framebuffer
+    // above (which the caller assigns to every member after this
+    // function returns).
+    SP<IFramebuffer> scratch = pLayers.front()->m_selfCaptureScratch;
+    if (!scratch)
+        scratch = createFB("shared self-capture scratch");
+    const Vector2D SCRATCH_SIZE = (pMonitor->m_pixelSize * SELF_CAPTURE_RENDER_SCALE).round();
+    if (scratch->m_size != SCRATCH_SIZE)
+        scratch->alloc(SCRATCH_SIZE.x, SCRATCH_SIZE.y, DRM_FORMAT_ABGR8888);
+    scratch->setImageDescription(pMonitor->workBufferImageDescription());
+    for (const auto& l : pLayers)
+        l->m_selfCaptureScratch = scratch;
+
+    // CLAUDE/local: same stutter-fix throttle as makeSelfCaptureBackgroundFB
+    // above -- own static, since this is a separate function/call site.
+    static Time::steady_tp selfCapScaleLastLog{};
+    const auto             selfCapScaleNow    = Time::steadyNow();
+    const bool             selfCapScaleLogNow = std::chrono::duration_cast<std::chrono::milliseconds>(selfCapScaleNow - selfCapScaleLastLog).count() > 2000;
+    if (selfCapScaleLogNow)
+        selfCapScaleLastLog = selfCapScaleNow;
+
+    if (selfCapScaleLogNow)
+        Log::logger->log(Log::DEBUG, "[selfCapScale] makeSharedSelfCaptureBackgroundFB monitor={} members={} monitorPx={}x{} scratchSize={}x{}", pMonitor->m_name, pLayers.size(),
+                          pMonitor->m_pixelSize.x, pMonitor->m_pixelSize.y, SCRATCH_SIZE.x, SCRATCH_SIZE.y);
+
+    // CLAUDE/local: same damage-region fix as makeSelfCaptureBackgroundFB above.
+    CRegion fakeDamage{0, 0, sc<int>(pMonitor->m_pixelSize.x), sc<int>(pMonitor->m_pixelSize.y)};
+    beginFullFakeRender(pMonitor, fakeDamage, scratch);
+
+    setViewport(0, 0, sc<int>(SCRATCH_SIZE.x), sc<int>(SCRATCH_SIZE.y));
+
+    m_bRenderingSnapshot = true;
+    // CLAUDE/local: same noSimplify fix as makeSelfCaptureBackgroundFB above.
+    m_renderData.noSimplify = true;
+
+    draw(CClearPassElement::SClearData{CHyprColor(0, 0, 0, 0)});
+    startRenderPass();
+
+    // CLAUDE/local: same fix as makeSelfCaptureBackgroundFB above -- full
+    // monitor size as geometry (internal scale 1.0), not SCRATCH_SIZE,
+    // which double-applies the downscale. See that function's own comment
+    // for the full root-cause explanation (confirmed via direct pixel dump).
+    for (const auto& l : pLayers)
+        l->m_hiddenForSelfCapture = true;
+    renderWorkspace(pMonitor, pMonitor->m_activeWorkspace, Time::steadyNow(), CBox{{0, 0}, pMonitor->m_pixelSize});
+    for (const auto& l : pLayers)
+        l->m_hiddenForSelfCapture = false;
+
+    endRender();
+
+    setViewport(0, 0, sc<int>(pMonitor->m_pixelSize.x), sc<int>(pMonitor->m_pixelSize.y));
+    if (selfCapScaleLogNow)
+        Log::logger->log(Log::DEBUG, "[selfCapScale] shared viewport restored to monitor size {}x{}", pMonitor->m_pixelSize.x, pMonitor->m_pixelSize.y);
+
+    auto* pSrcFB  = dynamic_cast<Render::GL::CGLFramebuffer*>(scratch.get());
+    auto* pDestFB = dynamic_cast<Render::GL::CGLFramebuffer*>(framebuffer.get());
+    if (pSrcFB && pDestFB) {
+        Render::GL::g_pHyprOpenGL->setCapStatus(GL_SCISSOR_TEST, false);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, pSrcFB->getFBID());
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, pDestFB->getFBID());
+        glBlitFramebuffer(0, 0, sc<int>(SCRATCH_SIZE.x), sc<int>(SCRATCH_SIZE.y), 0, 0, sc<int>(pMonitor->m_pixelSize.x), sc<int>(pMonitor->m_pixelSize.y), GL_COLOR_BUFFER_BIT,
+                           GL_LINEAR);
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        if (selfCapScaleLogNow)
+            Log::logger->log(Log::DEBUG, "[selfCapScale] shared blitted scratch {}x{} -> background {}x{}", SCRATCH_SIZE.x, SCRATCH_SIZE.y, pMonitor->m_pixelSize.x,
+                              pMonitor->m_pixelSize.y);
+    } else
+        Log::logger->log(Log::ERR, "[selfCapScale] BUG: shared scratch/background dynamic_cast to CGLFramebuffer failed, snapshot not updated this call");
+
+    m_bRenderingSnapshot = false;
+    return framebuffer;
+}
