# ── Build artifacts ───────────────────────────────────────────────────
# The plugin .so is rebuilt from plugin/src/ against the installed Hyprland
# headers, and is pinned to that exact build, so it is never portable enough
# to be worth committing.
*.so
*.qsb.tmp

# Python bytecode — install/engine.py and friends. Version- and
# machine-specific (cpython-314), regenerated on every run.
__pycache__/
*.py[cod]

# ── Runtime, scratch and crash output ─────────────────────────────────
*.log
dev/shots/
core
core.[0-9]*

# ── Backups, whether left by tooling or by hand ───────────────────────
.claude-backups/
*.bak
*.orig
*.rej
*~

# ── Local, not shared ─────────────────────────────────────────────────
.claude/settings.local.json

# Your own font files. SF Pro, SF Mono, Google Sans Flex and PP Editorial New
# are all proprietary and cannot be redistributed, so they are never committed;
# install/scripts/fonts.sh installs whatever is here.
assets/fonts-local/

# Generated by splash/generate-wordmark.py: glyph outlines pulled from whatever
# font is installed locally. Same reason the fonts themselves are not here.
splash/wordmark.json

# ── Editor / OS noise ─────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Except this one: it ships with end-4 upstream, so it stays tracked.
!quickshell/translations/en_US.json.bak
